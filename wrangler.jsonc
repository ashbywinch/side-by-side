{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "side-by-side",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "sbs.blueumbrella.net",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": true
}
