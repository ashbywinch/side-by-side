# Corpus data is plain text so Cloudflare compresses it (br/gzip).
# The chunk files are whole objects, so the edge caches them well.
/api/books/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Vite fingerprints every file in /assets, so it is safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Version preview URLs must never be indexed.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
