{
  "name": "side-by-side-vite",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite --port 8080",
    "build": "npm run data && vite build && node scripts/write-version.mjs",
    "data": "node scripts/build-corpus.mjs",
    "check-corpus": "node scripts/check-corpus.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "smoke": "node scripts/smoke.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format": "prettier .  --write",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@popperjs/core": "^2.11.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "pinia": "^4.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.5.44",
    "vue-multiselect": "^3.5.0",
    "vue-responsiveness": "^0.2.5",
    "vue-router": "^5.4.0",
    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "msw": "^3.0.3",
    "npm-check-updates": "^23.1.1",
    "prettier": "3.9.10",
    "prettier-eslint": "^17.1.2",
    "sass": "^1.106.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
