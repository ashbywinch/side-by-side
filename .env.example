# .env.example — every env var documented, values blank.
#
# Side by Side has no runtime environment variables today: the site is a
# static SPA and the corpus is generated at build time. Future server-backed
# features (Google sign-in, bookshelf sync) must add their variables here
# with a one-line description each, blank values, and real values only in the
# shell or the deployment platform's secret store.

# OPENAI_BASE_URL=       # LLM gateway, if the app ever calls an LLM at runtime
# OPENAI_API_KEY=        # LLM gateway key, never committed
