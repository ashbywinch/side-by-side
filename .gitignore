# .gitignore — the house set, curated.
#
# Never ignore lockfiles; they are committed for reproducibility.
# Test fixtures are committed; only recreatable build output is ignored.

# env/secrets
.env
.env.local
*.keystore

# deps and build output
node_modules/
dist/
dist-ssr/
public/api/

# caches and coverage
coverage/
coverage.xml
*.tsbuildinfo
vite.config.d.mts

# tooling / agent state
.wrangler/
.opencode/
.sisyphus/
.code-review-graph/
.logs/
.tools/

# IDE/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local env copies
*.local
